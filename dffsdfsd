local function doAntiAFKAction()
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    
    local mode = settings.mode
    local dist = settings.moveDistance
    local rand = settings.randomFactor
    
    -- Случайное отклонение
    local function r()
        return 1 + (math.random() - 0.5) * 2 * rand
    end
    
    if mode == "WALK" then
        local angle = math.rad(math.random() * 360)
        local offset = Vector3.new(math.cos(angle), 0, math.sin(angle)) * dist * r()
        if settings.useSmoothTween and hrp then
            local tween = TweenService:Create(hrp, TweenInfo.new(0.3), {CFrame = hrp.CFrame + offset})
            tween:Play()
        else
            hrp.CFrame += offset
        end
        
    elseif mode == "JUMP" then
        if hum and hum:GetState() == Enum.HumanoidStateType.Landed then
            hum.Jump = true
        end
        
    elseif mode == "CROUCH" then
        -- эмулируем нажатие клавиши (работает в некоторых играх)
        if hum then
            hum.Sit = not hum.Sit
        end
        
    elseif mode == "CAMERA_SHAKE" then
        local cam = workspace.CurrentCamera
        if cam then
            local origCFrame = cam.CFrame
            local shakeOffset = CFrame.new(math.random(-1,1)*dist*0.3, math.random(-1,1)*dist*0.3, 0)
            cam.CFrame = origCFrame * shakeOffset
            task.wait(0.15)
            cam.CFrame = origCFrame
        end
        
    elseif mode == "SPIN" then
        if hrp then
            hrp.CFrame *= CFrame.Angles(0, math.rad(dist * 20 * r()), 0)
        end
        
    elseif mode == "COMBO" then
        -- шаг + прыжок
        local angle = math.rad(math.random() * 360)
        local offset = Vector3.new(math.cos(angle), 0, math.sin(angle)) * dist * 0.5 * r()
        hrp.CFrame += offset
        task.wait(0.1)
        if hum and hum:GetState() == Enum.HumanoidStateType.Landed then
            hum.Jump = true
        end
    end
    
    actionCounter += 1
    addLog("Действие #" .. actionCounter .. " (" .. Modes[mode] .. ")")
end

