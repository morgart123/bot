-- ПОИСК НОВОГО СЛАП-ФАРМА. ЧАСТЬ 2: ГЛУБОКИЙ ТЕСТ 10 ЭВЕНТОВ
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = game:GetService("Players").LocalPlayer
local char = LocalPlayer.Character
if not char then return end
local hrp = char:FindFirstChild("HumanoidRootPart")
if not hrp then return end

local txt = ""

-- Список подозрительных эвентов для теста
local testList = {
    "ClientUsedAbility",
    "CustomHit",
    "Framework_UseAbility",
    "Framework_OnHit",
    "Spinner",
    "RemoteEvent",  -- общий
    "Confuse",
    "TheForce2",
    "UTGHit",
    "SpinInit",
}

-- Аргументы для теста: [описание, {аргументы}]
local argSets = {
    {"пусто", {}},
    {"число 1", {1}},
    {"число 999", {999}},
    {"строка 'Slap'", {"Slap"}},
    {"строка 'Use'", {"Use"}},
    {"таблица {}", {{}}},
    {"LocalPlayer", {LocalPlayer}},
    {"HRP (часть тела)", {hrp}},
    {"HRP.Position", {hrp.Position}},
}

for _, eventName in ipairs(testList) do
    local ev = ReplicatedStorage:FindFirstChild(eventName)
    if not ev then
        -- ищем во вложенных папках
        for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
            if obj.Name == eventName and obj:IsA("RemoteEvent") then
                ev = obj
                break
            end
        end
    end
    
    if ev and ev:IsA("RemoteEvent") then
        txt = txt .. "\n=== " .. eventName .. " ==="
        for _, argSet in ipairs(argSets) do
            local desc = argSet[1]
            local args = argSet[2]
            -- 3 вызова подряд с задержкой
            for i = 1, 3 do
                pcall(function()
                    ev:FireServer(unpack(args))
                end)
                task.wait(0.03)
            end
            txt = txt .. "\n  " .. desc .. " (x3)"
        end
    else
        txt = txt .. "\n" .. eventName .. " не найден"
    end
end

setclipboard(txt)
print(txt)
print("\nПРОВЕРЬ СЛАПЫ (leaderstats -> Slaps). Если увеличились — напиши, после какого эвента.")
