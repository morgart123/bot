-- ================= УВЕДОМЛЕНИЯ =================
local function notify(msg)
    StarterGui:SetCore("SendNotification", { Title = "AutoBountyReset", Text = msg, Duration = 3 })
end

-- ================= УТИЛИТЫ =================
local function killThread(thread)
    if thread then pcall(task.cancel, thread) end
    return nil
end

local function getRemote()
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    if not ls then return ReplicatedStorage:FindFirstChild("GeneralHit") end
    local glove = ls:FindFirstChild("Glove")
    if not glove then return ReplicatedStorage:FindFirstChild("GeneralHit") end
    local name = gloveHitsList[glove.Value] or 'GeneralHit'
    return ReplicatedStorage:FindFirstChild(name) or ReplicatedStorage:FindFirstChild("GeneralHit")
end

local function getBodyParts(char)
    if not char then return {} end
    local parts = {}
    for _, n in ipairs(BODY_PARTS) do
        local p = char:FindFirstChild(n)
        if p then table.insert(parts, p) end
    end
    return parts
end

-- ================= EXTRA GIVER (ТОЛЬКО СЕБЕ) =================
local isExtraActive = false
local extraThread = nil
local customExtraHits = 200

local function doExtraBurst()
    local char = LocalPlayer.Character
    if not char then return end
    local myParts = getBodyParts(char)
    if #myParts == 0 then return end
    local remote = getRemote()
    if not remote then return end
    for i = 1, customExtraHits do
        for _, part in ipairs(myParts) do
            remote:FireServer(part)
        end
    end
end

local function startExtra()
    if isExtraActive then return end
    isExtraActive = true
    extraThread = task.spawn(function()
        while isExtraActive do
            doExtraBurst()
            task.wait(0.6)
        end
    end)
end

local function stopExtra()
    isExtraActive = false
    extraThread = killThread(extraThread)
end

-- ================= ПОЛУЧЕНИЕ БАУНТИ =================
local function getBounty()
    local char = LocalPlayer.Character
    if not char then return nil end
    local bb = char:FindFirstChild("bounty_billboard")
    if not bb then
        for _, v in ipairs(char:GetDescendants()) do
            if v.Name == "bounty_billboard" then bb = v; break end
        end
    end
    if bb then
        local tl = bb:FindFirstChild("TextLabel") or bb:FindFirstChildOfClass("TextLabel")
        if tl then return tonumber(tl.Text) end
    end
    return nil
end

-- ================= ПОИСК ИГРОКА =================
local function findPlayer(name)
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():find(name:lower()) or p.DisplayName:lower():find(name:lower()) then return p end
    end
    return nil
end

-- ================= ОСНОВНОЙ ЦИКЛ =================
local masterRunning = false
local victim = nil
local savedPosition = nil
local cycleInProgress = false

local function mainLoop()
    while masterRunning do
        repeat
            task.wait(0.2)
            Status.Text = "Bounty: " .. (getBounty() or "?") .. " | Waiting for 1000"
        until not masterRunning or (not cycleInProgress and getBounty() and getBounty() >= 1000)
        if not masterRunning then break end

        cycleInProgress = true
        Status.Text = "Bounty: 1000 | Stopping Giver..."
        stopExtra()
        task.wait(0.5)

        local char = LocalPlayer.Character
        local myRoot = char and char:FindFirstChild("HumanoidRootPart")
        if not myRoot then
            Status.Text = "Error: no character root"
            startExtra()
            task.wait(1)
            cycleInProgress = false
            continue
        end
        savedPosition = myRoot.CFrame

        if not victim or not victim.Character or not victim.Character:FindFirstChild("HumanoidRootPart") then
            Status.Text = "Error: victim not available"
            startExtra()
            task.wait(2)
            cycleInProgress = false
            continue
        end
        local tChar = victim.Character
        local tRoot = tChar:FindFirstChild("HumanoidRootPart")
        local tInArena = tChar:FindFirstChild("isInArena")
        local iInArena = char:FindFirstChild("isInArena")
        if not (tRoot and tInArena and tInArena.Value and iInArena and iInArena.Value) then
            Status.Text = "Error: victim or you not in arena"
            startExtra()
            task.wait(2)
            cycleInProgress = false
            continue
        end

        local tpTarget = tRoot.CFrame * CFrame.new(0, 0, -5)
        pcall(function() char:SetPrimaryPartCFrame(tpTarget) end)
        if (myRoot.CFrame.Position - tpTarget.Position).Magnitude > 10 then
            myRoot.CFrame = tpTarget
        end
        Status.Text = "Bounty: 1000 | Teleported to " .. victim.Name
        task.wait(0.3)

        local ragdolled = char:FindFirstChild("Ragdolled")
        local resetEvent = LocalPlayer:FindFirstChild("Reset")
        if not ragdolled or not resetEvent then
            Status.Text = "Error: no Ragdoll/Reset"
            startExtra()
            task.wait(1)
            cycleInProgress = false
            continue
        end
        while not ragdolled.Value do
            task.wait(0.1)
            if not masterRunning then break end
        end
        if not masterRunning then break end

        resetEvent:FireServer()
        Status.Text = "Bounty: 1000 | Reset..."
        task.wait(0.5)

        repeat task.wait(0.2) until not masterRunning or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))
        if not masterRunning then break end
        task.wait(5)

        local portal = Workspace:FindFirstChild("Lobby") and Workspace.Lobby:FindFirstChild("Teleport1")
        if not portal or not portal:IsA("BasePart") then
            Status.Text = "Error: portal not found"
            startExtra()
            task.wait(1)
            cycleInProgress = false
            continue
        end

        local enteredArena = false
        for attempt = 1, 5 do
            if not masterRunning then break end
            local curChar = LocalPlayer.Character
            local curRoot = curChar and curChar:FindFirstChild("HumanoidRootPart")
            if not curRoot then
                Status.Text = "Lost character, waiting..."
                repeat task.wait(0.2) until not masterRunning or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))
                if not masterRunning then break end
                task.wait(2)
                continue
            end
            curRoot.CFrame = portal.CFrame
            Status.Text = "Entering portal (attempt " .. attempt .. ")"
            task.wait(0.8)
            for i = 1, 10 do
                task.wait(0.3)
                if not masterRunning then break end
                local checkChar = LocalPlayer.Character
                if not checkChar then break end
                local isInArena = checkChar:FindFirstChild("isInArena")
                if isInArena and isInArena.Value then enteredArena = true; break end
            end
            if enteredArena then break end
        end
        if not masterRunning then break end
        if not enteredArena then
            Status.Text = "Error: failed to enter arena"
            startExtra()
            task.wait(1)
            cycleInProgress = false
            continue
        end

        -- Возврат на позицию (с повторами)
        if savedPosition then
            local finalChar = LocalPlayer.Character
            local finalRoot = finalChar and finalChar:FindFirstChild("HumanoidRootPart")
            if finalRoot then
                for attempt = 1, 10 do
                    finalRoot.CFrame = savedPosition
                    task.wait(0.05)
                    local dist = (finalRoot.Position - savedPosition.Position).Magnitude
                    if dist < 5 then break end
                    pcall(function() finalChar:SetPrimaryPartCFrame(savedPosition) end)
                    task.wait(0.05)
                end
                Status.Text = "Bounty: 1000 | Returned to position"
                task.wait(1)
            end
        end

        local dropWait = 0
        repeat
            task.wait(0.3)
            dropWait = dropWait + 0.3
            local b = getBounty()
            Status.Text = "Bounty: " .. (b or "?") .. " | Waiting for drop (timeout in " .. math.floor(10 - dropWait) .. "s)"
        until not masterRunning or (getBounty() and getBounty() < 1000) or dropWait >= 10

        Status.Text = "Restarting Giver..."
        startExtra()
        task.wait(2)

        savedPosition = nil
        cycleInProgress = false
    end
end

