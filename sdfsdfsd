    end
end)

-- Target Slaps Farm
TargetButton.MouseButton1Click:Connect(function()
    local target = tonumber(TargetTextBox.Text) or 1000
    if target <= getSlaps() then TargetButton.Text = "DONE" return end
    TargetButton.Text = "FARMING"
    farmSlapsUntil(target)
end)

-- Character reset
LocalPlayer.CharacterAdded:Connect(function()
    isFarming = false
    isExtraFarming = false
    stopSpamConnection()
    stopExtraSpamConnection()
    if ToggleButton then ToggleButton.Text = "OFF" ToggleButton.BackgroundColor3 = Color3.fromRGB(255, 60, 60) end
    if ExtraToggleButton then ExtraToggleButton.Text = "OFF" ExtraToggleButton.BackgroundColor3 = Color3.fromRGB(255, 60, 60) end
end)
