-- ==========================================
-- Безопасные утилиты
-- ==========================================
local function stopThread(thread)
    if thread then pcall(task.cancel, thread) end
    return nil
end

local function getSafeNumber(text)
    local value = tonumber(text)
    if not value then return 100 end
    return math.clamp(math.floor(value), 1, 10000)
end

-- ==========================================
-- GET REMOTE BY GLOVE
-- ==========================================
local function getCurrentRemote()
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if not leaderstats then return ReplicatedStorage:FindFirstChild("GeneralHit") end
    local gloveStat = leaderstats:FindFirstChild("Glove")
    if not gloveStat then return ReplicatedStorage:FindFirstChild("GeneralHit") end
    local gloveName = gloveStat.Value
    local remoteName = gloveHitsList[gloveName] or 'GeneralHit'
    return ReplicatedStorage:FindFirstChild(remoteName) or ReplicatedStorage:FindFirstChild("GeneralHit")
end

-- ==========================================
-- GET ALL BODY PARTS FROM CHARACTER
-- ==========================================
local function getAllBodyParts(character)
    if not character then return {} end
    local parts = {}
    for _, partName in ipairs(BODY_PARTS) do
        local part = character:FindFirstChild(partName)
        if part then table.insert(parts, part) end
    end
    return parts
end

-- ==========================================
-- ФУНКЦИИ ФАРМА
-- ==========================================
local function executeBountyBurst(amountOfHits)
    local character = LocalPlayer.Character
    if not character then return end
    local parts = getAllBodyParts(character)
    if #parts == 0 then return end
    local remote = getCurrentRemote()
    if not remote then return end
    for i = 1, amountOfHits do
        for _, part in ipairs(parts) do
            remote:FireServer(part)
        end
    end
end

local function executeExtraBountyBurst(amountOfHits)
    local allPlayers = Players:GetPlayers()
    local allParts = {}
    for _, player in ipairs(allPlayers) do
        if player.Character then
            local parts = getAllBodyParts(player.Character)
            for _, part in ipairs(parts) do
                table.insert(allParts, part)
            end
        end
    end
    if #allParts == 0 then return end
    local remote = getCurrentRemote()
    if not remote then return end
    for i = 1, amountOfHits do
        for _, part in ipairs(allParts) do
            remote:FireServer(part)
        end
    end
end

local function stopSpamConnection()
    farmThread = stopThread(farmThread)
end

local function stopExtraSpamConnection()
    extraFarmThread = stopThread(extraFarmThread)
end

local function startSpamConnection()
    stopSpamConnection()
    farmThread = task.spawn(function()
        while isFarming do
            executeBountyBurst(200)
            task.wait(0.6)
        end
    end)
end

local function startExtraSpamConnection()
    stopExtraSpamConnection()
    extraFarmThread = task.spawn(function()
        while isExtraFarming do
            executeExtraBountyBurst(customExtraHits)
            task.wait(0.6)
        end
    end)
end

-- ==========================================
-- ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
-- ==========================================
local function getSlaps()
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    if ls then
        local s = ls:FindFirstChild("Slaps")
        if s then return s.Value end
    end
    return 0
end

local function farmSlapsUntil(targetSlaps)
    task.spawn(function()
        while getSlaps() < targetSlaps do
            local best, bestBounty = nil, 0
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local hum = p.Character:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        local bounty = 0
                        local bountyObj = p.Character:FindFirstChild("TotalBounty")
                        if bountyObj and bountyObj:IsA("IntValue") then
                            bounty = bountyObj.Value
                        end
                        if bounty > bestBounty then
                            bestBounty = bounty
                            best = p
                        end
                    end
                end
            end
            if not best then task.wait(3) continue end
            local targetHrp = best.Character and best.Character:FindFirstChild("HumanoidRootPart")
            local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not targetHrp or not myHrp then task.wait(1) continue end
            targetHrp.CFrame = myHrp.CFrame + Vector3.new(0, 3, 0)
            task.wait(0.3)
            local remote = getCurrentRemote()
            if remote then
                for i = 1, 50 do
                    pcall(function() remote:FireServer(targetHrp) end)
                    task.wait(0.01)
                end
            end
            local hum = best.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.Health = 0 else best.Character:BreakJoints() end
            task.wait(1)
            if TargetButton and TargetButton.Parent then
                TargetButton.Text = math.min(getSlaps(), targetSlaps) .. "/" .. targetSlaps
            end
        end
        if TargetButton and TargetButton.Parent then TargetButton.Text = "DONE" end
    end)
end

