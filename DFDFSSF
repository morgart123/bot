local heartbeatConnection
heartbeatConnection = RunService.Heartbeat:Connect(function()
    if state.closed then
        return
    end

    if not state.controlling then
        return
    end

    local sentry = state.sentry
    local root = state.root
    local target = state.targetPosition

    if not sentry or not root or not target or not sentry.Parent or not root.Parent then
        log("CONTROLLER STOPPED: SENTRY DESTROYED")
        stopController(true)
        updateIndicators("SENTRY DESTROYED")
        return
    end

    if getOwnerId(sentry) ~= LocalPlayer.UserId then
        log("CONTROLLER STOPPED: OWNER ID CHANGED")
        stopController(true)
        updateIndicators("OWNER ID CHANGED")
        return
    end

    if networkOwnerFunction and ownsPhysics(root) == false then
        state.ownershipLostAt = state.ownershipLostAt or os.clock()

        if os.clock() - state.ownershipLostAt < OWNERSHIP_GRACE_SECONDS then
            updateIndicators("OWNERSHIP TRANSIENT — WAITING")
            return
        end

        log("CONTROLLER PAUSED: NETWORK OWNERSHIP LOST")
        state.controlling = false
        state.pausedForOwnership = true
        restoreBodyVelocities()
        updateIndicators("PAUSED — MOVE CLOSER; AUTO RESUME")
        return
    elseif state.ownershipLostAt then
        log("NETWORK OWNERSHIP RECOVERED DURING GRACE")
        state.ownershipLostAt = nil
    end

    -- Re-apply the local neutralization in case the physics object updates.
    saveAndNeutralizeBodyVelocities()

    local errorVector = target - root.Position
    local distance = errorVector.Magnitude

    if state.movementMode == "SNAP" then
        snapRootTo(target)
    else
        local desiredVelocity = Vector3.zero

        if distance > 0.025 then
            local configuredSpeed = numberFromBox(speedBox, DEFAULT_SPEED)
            local speed = math.min(
                configuredSpeed,
                math.max(0.8, distance * POSITION_GAIN)
            )
            desiredVelocity = errorVector.Unit * speed
        end

        root.AssemblyLinearVelocity = desiredVelocity
        root.AssemblyAngularVelocity = Vector3.zero
    end

    if state.returning then
        if distance <= 0.18 then
            state.returnStableSince = state.returnStableSince or os.clock()

            if os.clock() - state.returnStableSince >= 0.4 then
                log("RESTORE COMPLETE; ERROR:", string.format("%.3f", distance))
                stopController(true)
                updateIndicators("RESTORED — FORCES RESTORED")
            end
        else
            state.returnStableSince = nil
        end
    end
end)

local function hasLiveCapturedSentry()
    return state.sentry ~= nil
        and state.root ~= nil
        and state.sentry.Parent ~= nil
        and state.root.Parent ~= nil
        and getOwnerId(state.sentry) == LocalPlayer.UserId
end

local statusAccumulator = 0
local autoScanAccumulator = 0
local statusConnection
statusConnection = RunService.Heartbeat:Connect(function(deltaTime)
    if state.closed then
        return
    end

    statusAccumulator = statusAccumulator + deltaTime
    autoScanAccumulator = autoScanAccumulator + deltaTime

    if state.pausedForOwnership
        and hasLiveCapturedSentry()
        and ownsPhysics(state.root) ~= false then

        if saveAndNeutralizeBodyVelocities() then
            state.pausedForOwnership = false
            state.ownershipLostAt = nil
            state.controlling = true
            log("CONTROLLER AUTO RESUMED: NETWORK OWNERSHIP RETURNED")
            updateIndicators("AUTO RESUMED")
        end
    end

    if autoScanAccumulator >= 0.5 then
        autoScanAccumulator = 0

        if state.autoCapture and not hasLiveCapturedSentry() then
            captureNearest("AUTO SCAN")
        end
    end

    if statusAccumulator >= 0.2 then
        statusAccumulator = 0
        updateIndicators()
    end
end)

local tagConnection = CollectionService:GetInstanceAddedSignal("Sentry"):Connect(function(sentry)
    task.spawn(function()
        local deadline = os.clock() + 4

        repeat
            if state.closed or not state.autoCapture or not sentry.Parent then
                return
            end

            local root = getSentryRoot(sentry)
            if getOwnerId(sentry) == LocalPlayer.UserId and root then
                local characterRoot = getCharacterRoot()
                local distance = characterRoot
                    and ((root.AssemblyRootPart or root).Position - characterRoot.Position).Magnitude
                    or -1

                captureSpecific(
                    sentry,
                    root.AssemblyRootPart or root,
                    distance,
                    "AUTO TAG"
                )
                return
            end

            task.wait(0.05)
        until os.clock() >= deadline
    end)
end)

local function followCharacterTeleport()
    if state.closed then
        return
    end

    local characterRoot = getCharacterRoot()
    if not characterRoot then
        state.lastCharacterPosition = nil
        return
    end

    local currentPosition = characterRoot.Position
    local previousPosition = state.lastCharacterPosition
    state.lastCharacterPosition = currentPosition

    if not state.followTeleport or not previousPosition then
        return
    end

    local delta = currentPosition - previousPosition
    if delta.Magnitude < TELEPORT_THRESHOLD then
        return
    end

    if not hasLiveCapturedSentry() then
        return
    end

    local root = state.root
    local ownerBefore = ownsPhysics(root)
    local destination = root.Position + delta
    local moved = snapRootTo(destination)

    if moved then
        if state.targetPosition then
            state.targetPosition = state.targetPosition + delta
        end
        if state.originalPosition then
            state.originalPosition = state.originalPosition + delta
        end

        state.ownershipLostAt = nil
        log("FOLLOW TP SHIFT:", delta)
        log("FOLLOW TP DISTANCE:", string.format("%.3f", delta.Magnitude))
        log("FOLLOW TP OWNER BEFORE:", ownerBefore)
        log("FOLLOW TP OWNER AFTER:", ownsPhysics(root))
        updateIndicators("FOLLOW TP MOVED SENTRY")
    else
        log("FOLLOW TP FAILED: ROOT MOVE ERROR")
        updateIndicators("FOLLOW TP FAILED")
    end
end

local teleportRootConnection
local function bindTeleportRoot(character)
    if teleportRootConnection then
        teleportRootConnection:Disconnect()
        teleportRootConnection = nil
    end

    task.spawn(function()
        local root = character and character:WaitForChild("HumanoidRootPart", 10)
        if state.closed or not root or character ~= LocalPlayer.Character then
            return
        end

        state.lastCharacterPosition = root.Position
        teleportRootConnection = root:GetPropertyChangedSignal("CFrame"):Connect(
            followCharacterTeleport
        )
    end)
end

