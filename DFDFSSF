local function stringify(...)
    local values = table.pack(...)
    for index = 1, values.n do
        values[index] = tostring(values[index])
    end
    return table.concat(values, " ")
end

local function log(...)
    local line = stringify(...)
    table.insert(report, line)
    print(line)
end

local function copyReport()
    local output = table.concat(report, "\n")
    if clipboardFunction then
        return pcall(clipboardFunction, output)
    end
    print(output)
    return false
end

local function pathOf(instance)
    local success, result = pcall(function()
        return instance:GetFullName()
    end)
    return success and result or tostring(instance)
end

local function getCharacterRoot()
    local character = LocalPlayer.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function getOwnerId(instance)
    local current = instance
    while current do
        local ownerId = current:GetAttribute("OwnerId")
        if ownerId ~= nil then
            return tonumber(ownerId)
        end
        if current == workspace then
            break
        end
        current = current.Parent
    end
    return nil
end

local function getSentryRoot(sentry)
    if sentry:IsA("BasePart") and sentry.Name == "TurretStandBase" then
        return sentry
    end

    local namedRoot = sentry:FindFirstChild("TurretStandBase", true)
    if namedRoot and namedRoot:IsA("BasePart") then
        return namedRoot
    end

    if sentry:IsA("Model") then
        return sentry.PrimaryPart
            or sentry:FindFirstChildWhichIsA("BasePart", true)
    end

    return nil
end

local function ownsPhysics(part)
    if not networkOwnerFunction then
        return nil
    end

    local success, result = pcall(networkOwnerFunction, part)
    if success then
        return result == true
    end
    return false
end

local function hasActiveTouch(sentry)
    if not sentry or not sentry.Parent then
        return false
    end

    local hitbox = sentry:FindFirstChild("Hitbox", true)
    return hitbox ~= nil
        and hitbox:FindFirstChildWhichIsA("TouchTransmitter") ~= nil
end

local function findNearestOwnedSentry()
    local characterRoot = getCharacterRoot()
    if not characterRoot then
        return nil, nil, nil
    end

    local selectedSentry
    local selectedRoot
    local selectedDistance = math.huge

    for _, sentry in ipairs(CollectionService:GetTagged("Sentry")) do
        if sentry
            and sentry.Parent
            and getOwnerId(sentry) == LocalPlayer.UserId then

            local root = getSentryRoot(sentry)
            if root and root.Parent and not root.Anchored then
                local assemblyRoot = root.AssemblyRootPart or root
                local distance = (assemblyRoot.Position - characterRoot.Position).Magnitude

                if distance < selectedDistance then
                    selectedSentry = sentry
                    selectedRoot = assemblyRoot
                    selectedDistance = distance
                end
            end
        end
    end

    return selectedSentry, selectedRoot, selectedDistance
end

local function saveAndNeutralizeBodyVelocities()
    if not state.sentry or not state.sentry.Parent then
        return false
    end

    if not state.bodyVelocities then
        state.bodyVelocities = {}

        for _, descendant in ipairs(state.sentry:GetDescendants()) do
            if descendant:IsA("BodyVelocity") then
                table.insert(state.bodyVelocities, {
                    instance = descendant,
                    maxForce = descendant.MaxForce,
                    velocity = descendant.Velocity,
                    p = descendant.P,
                })
            end
        end

        log("BODYVELOCITIES CAPTURED:", #state.bodyVelocities)
    end

    for _, record in ipairs(state.bodyVelocities) do
        local bodyVelocity = record.instance
        if bodyVelocity and bodyVelocity.Parent then
            pcall(function()
                bodyVelocity.MaxForce = Vector3.zero
                bodyVelocity.Velocity = Vector3.zero
                bodyVelocity.P = 0
            end)
        end
    end

    return #state.bodyVelocities > 0
end

local function restoreBodyVelocities()
    if not state.bodyVelocities then
        return
    end

    for _, record in ipairs(state.bodyVelocities) do
        local bodyVelocity = record.instance
        if bodyVelocity and bodyVelocity.Parent then
            pcall(function()
                bodyVelocity.MaxForce = record.maxForce
                bodyVelocity.Velocity = record.velocity
                bodyVelocity.P = record.p
            end)
        end
    end

    log("BODYVELOCITIES RESTORED")
    state.bodyVelocities = nil
end

local function stopController(restoreForces)
    state.controlling = false
    state.returning = false
    state.returnStableSince = nil
    state.ownershipLostAt = nil
    state.pausedForOwnership = false

    if state.root and state.root.Parent then
        pcall(function()
            state.root.AssemblyLinearVelocity = Vector3.zero
            state.root.AssemblyAngularVelocity = Vector3.zero
        end)
    end

    if restoreForces then
        restoreBodyVelocities()
    end
end

local function snapRootTo(targetPosition)
    local root = state.root
    if not root or not root.Parent then
        return false
    end

    local success = pcall(function()
        root.CFrame = CFrame.new(targetPosition) * root.CFrame.Rotation
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)

    return success
end

