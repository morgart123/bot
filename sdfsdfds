    {BackgroundTransparency = 0.7}
)
pulseTween:Play()

-- ============= ЛОГИКА АНТИ-АФК =============
local enabled = ENABLED
local lastMove = 0

local function antiAFK(deltaTime)
    if not enabled then return end
    lastMove += deltaTime
    if lastMove < MOVE_INTERVAL then return end
    lastMove = 0

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- Случайное направление по X и Z
    local angle = math.rad(math.random() * 360)
    local offset = Vector3.new(math.cos(angle), 0, math.sin(angle)) * MOVE_DISTANCE
    hrp.CFrame += offset
end

RunService.Heartbeat:Connect(antiAFK)

