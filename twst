local function dumpFunctionDetails(fn, index, reason)
    writeLine(
        "ENGINEER_FUNCTION",
        "index=" .. index,
        "reason=" .. reason,
        "info=" .. valueString(fn)
    )

    if debug and type(debug.getconstants) == "function" then
        local success, constants = pcall(debug.getconstants, fn)
        if success then
            writeLine(
                "FUNCTION_CONSTANTS",
                "index=" .. index,
                "values=" .. valueString(constants)
            )
        end
    end

    if debug and type(debug.getupvalues) == "function" then
        local success, upvalues = pcall(debug.getupvalues, fn)

        if success then
            for upvalueIndex, upvalue in pairs(upvalues) do
                writeLine(
                    "FUNCTION_UPVALUE",
                    "functionIndex=" .. index,
                    "upvalueIndex=" .. tostring(upvalueIndex),
                    "type=" .. typeof(upvalue),
                    "value=" .. valueString(upvalue)
                )
            end
        end
    end

    if debug and type(debug.getprotos) == "function" then
        local success, protos = pcall(debug.getprotos, fn)
        if success then
            writeLine(
                "FUNCTION_PROTOS",
                "functionIndex=" .. index,
                "count=" .. #protos
            )
        end
    end
end

local function dumpEngineerClosures(reason)
    writeLine("BEGIN_CLOSURE_DUMP", reason)

    if type(getgc) ~= "function" then
        writeLine("CLOSURE_DUMP", "getgc unavailable")
        return
    end

    local engineerScript = findEngineerScript()
    local success, objects = pcall(getgc, true)

    if not success then
        writeLine("CLOSURE_DUMP", "getgc error=" .. tostring(objects))
        return
    end

    local matched = 0

    for _, object in ipairs(objects) do
        if type(object) == "function" then
            local match = false
            local reasonText = ""

            if type(getfenv) == "function" then
                local envSuccess, functionEnv = pcall(getfenv, object)

                if envSuccess and type(functionEnv) == "table" then
                    local ownerScript = rawget(functionEnv, "script")

                    if engineerScript and ownerScript == engineerScript then
                        match = true
                        reasonText = "getfenv.script"
                    elseif typeof(ownerScript) == "Instance"
                        and string.find(
                            string.lower(safeFullName(ownerScript)),
                            "engineer",
                            1,
                            true
                        ) then

                        match = true
                        reasonText = "engineer source path"
                    end
                end
            end

            if not match and debug and type(debug.info) == "function" then
                local infoSuccess, source = pcall(debug.info, object, "s")

                if infoSuccess
                    and string.find(
                        string.lower(tostring(source)),
                        "engineer",
                        1,
                        true
                    ) then

                    match = true
                    reasonText = "debug source"
                end
            end

            if match then
                matched += 1
                dumpFunctionDetails(object, matched, reasonText)
                task.wait()
            end
        end
    end

    writeLine("END_CLOSURE_DUMP", reason, "matched=" .. matched)
end

local function addSourceCandidate(candidates, seen, object)
    if not object
        or seen[object]
        or not object:IsA("LuaSourceContainer") then

        return
    end

    seen[object] = true
    table.insert(candidates, object)
end

local function resolvePath(root, names)
    local object = root

    for _, name in ipairs(names) do
        object = object and object:FindFirstChild(name)
    end

    return object
end

local function dumpRelevantSources()
    writeLine("BEGIN_SOURCE_DUMP")

    if type(decompile) ~= "function" then
        writeLine("SOURCE_DUMP", "decompile unavailable")
        return
    end

    local candidates = {}
    local seen = {}
    local tool = findEngineerTool()

    if tool then
        for _, object in ipairs(tool:GetDescendants()) do
            addSourceCandidate(candidates, seen, object)
        end
    end

    for _, object in ipairs({
        ReplicatedStorage:FindFirstChild("CooldownModule"),
        resolvePath(ReplicatedFirst, {"Dependencies", "GloveCommonClient"}),
        resolvePath(ReplicatedFirst, {"Dependencies", "GloveMasteryClient"})
    }) do
        addSourceCandidate(candidates, seen, object)
    end

    if type(getloadedmodules) == "function" then
        local success, loaded = pcall(getloadedmodules)

        if success then
            for _, module in ipairs(loaded) do
                local path = string.lower(safeFullName(module))
                local unrelatedSentrySdk = string.find(
                    path,
                    "sentrysdk",
                    1,
                    true
                ) ~= nil
                    or string.find(path, "corepackages", 1, true) ~= nil

                if not unrelatedSentrySdk
                    and (string.find(path, "engineer", 1, true)
                        or string.find(path, "sentry", 1, true)) then

                    addSourceCandidate(candidates, seen, module)
                end
            end
        end
    end

    writeLine("SOURCE_CANDIDATES", "count=" .. #candidates)

    for index, sourceObject in ipairs(candidates) do
        writeLine(
            "SOURCE_BEGIN",
            "index=" .. index,
            "path=" .. safeFullName(sourceObject),
            "class=" .. sourceObject.ClassName
        )

        if type(getscriptbytecode) == "function" then
            local byteSuccess, bytecode = pcall(getscriptbytecode, sourceObject)
            writeLine(
                "SOURCE_BYTECODE",
                "index=" .. index,
                "success=" .. tostring(byteSuccess),
                "bytes=" .. tostring(byteSuccess and #bytecode or 0)
            )
        end

        local success, source = pcall(decompile, sourceObject)

        if success then
            writeRawBlock(
                "SOURCE_" .. index .. "_" .. sourceObject.Name,
                source
            )
        else
            writeLine(
                "SOURCE_ERROR",
                "index=" .. index,
                "error=" .. tostring(source)
            )
        end

        task.wait()
    end

    writeLine("END_SOURCE_DUMP")
end

