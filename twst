local function safeFullName(object)
    if typeof(object) ~= "Instance" then
        return tostring(object)
    end

    local success, result = pcall(function()
        return object:GetFullName()
    end)

    return success and result or (object.ClassName .. ":" .. object.Name)
end

local function safeProperty(object, property)
    local success, result = pcall(function()
        return object[property]
    end)

    if success then
        return result
    end

    return "<unavailable>"
end

local function cframeString(value)
    local components = {value:GetComponents()}

    for index, component in ipairs(components) do
        components[index] = string.format("%.9g", component)
    end

    return "CFrame(" .. table.concat(components, ",") .. ")"
end

local function valueString(value, depth, seen)
    depth = depth or 0
    seen = seen or {}

    local valueType = typeof(value)

    if valueType == "Instance" then
        return "<" .. value.ClassName .. ":" .. safeFullName(value) .. ">"
    elseif valueType == "CFrame" then
        return cframeString(value)
    elseif valueType == "Vector3"
        or valueType == "Vector2"
        or valueType == "Color3"
        or valueType == "UDim"
        or valueType == "UDim2"
        or valueType == "Ray"
        or valueType == "EnumItem"
        or valueType == "NumberRange"
        or valueType == "NumberSequence"
        or valueType == "ColorSequence" then

        return tostring(value)
    elseif valueType == "RaycastParams" then
        local filter = {}

        for _, object in ipairs(value.FilterDescendantsInstances) do
            table.insert(filter, safeFullName(object))
        end

        return "RaycastParams{FilterType="
            .. tostring(value.FilterType)
            .. ",IgnoreWater="
            .. tostring(value.IgnoreWater)
            .. ",CollisionGroup="
            .. tostring(value.CollisionGroup)
            .. ",Filter={"
            .. table.concat(filter, ",")
            .. "}}"
    elseif valueType == "OverlapParams" then
        local filter = {}

        for _, object in ipairs(value.FilterDescendantsInstances) do
            table.insert(filter, safeFullName(object))
        end

        return "OverlapParams{FilterType="
            .. tostring(value.FilterType)
            .. ",MaxParts="
            .. tostring(value.MaxParts)
            .. ",CollisionGroup="
            .. tostring(value.CollisionGroup)
            .. ",Filter={"
            .. table.concat(filter, ",")
            .. "}}"
    elseif valueType == "function" then
        local description = "function"

        if debug and type(debug.info) == "function" then
            local success, source, line, name = pcall(
                debug.info,
                value,
                "sln"
            )

            if success then
                description = string.format(
                    "function{source=%s,line=%s,name=%s}",
                    tostring(source),
                    tostring(line),
                    tostring(name)
                )
            end
        end

        return description
    elseif valueType == "table" then
        if seen[value] then
            return "<recursive-table>"
        end

        if depth >= 2 then
            local count = 0
            for _ in pairs(value) do
                count += 1
            end
            return "<table entries=" .. count .. ">"
        end

        seen[value] = true
        local entries = {}

        for key, child in pairs(value) do
            table.insert(
                entries,
                "["
                    .. valueString(key, depth + 1, seen)
                    .. "]="
                    .. valueString(child, depth + 1, seen)
            )
        end

        table.sort(entries)
        seen[value] = nil
        return "{" .. table.concat(entries, ",") .. "}"
    elseif valueType == "string" then
        return string.format("%q", value)
    end

    return tostring(value)
end

local function updateDisplay(line)
    table.insert(recentLines, line)

    while #recentLines > 180 do
        table.remove(recentLines, 1)
    end

    if LogLabel then
        LogLabel.Text = table.concat(recentLines, "\n")
    end
end

local function flush()
    if #pendingLines == 0 then
        return
    end

    local chunk = table.concat(pendingLines, "\n") .. "\n"
    table.clear(pendingLines)
    pendingBytes = 0

    if HAS_APPENDFILE then
        pcall(appendfile, FILE_NAME, chunk)
    elseif HAS_WRITEFILE then
        fallbackFile ..= chunk
        pcall(writefile, FILE_NAME, fallbackFile)
    else
        fallbackFile ..= chunk
    end
end

local function writeLine(kind, ...)
    local values = {...}

    for index, value in ipairs(values) do
        values[index] = valueString(value)
    end

    local line = string.format("%s\t%.3f\t%s", kind, elapsed(), table.concat(values, "\t"))
    table.insert(pendingLines, line)
    pendingBytes += #line + 1
    updateDisplay(line)
    print(line)

    if #pendingLines >= 40 or pendingBytes >= 32768 then
        flush()
    end
end

local function writeRawBlock(label, text)
    flush()
    text = tostring(text or "")

    local header = string.format(
        "BEGIN_%s\t%.3f\tbytes=%d\n",
        label,
        elapsed(),
        #text
    )
    local footer = string.format("\nEND_%s\t%.3f\n", label, elapsed())
    local block = header .. text .. footer

    if HAS_APPENDFILE then
        local position = 1
        local chunkSize = 65536

        while position <= #block do
            pcall(
                appendfile,
                FILE_NAME,
                block:sub(position, position + chunkSize - 1)
            )
            position += chunkSize
            task.wait()
        end
    elseif HAS_WRITEFILE then
        fallbackFile ..= block
        pcall(writefile, FILE_NAME, fallbackFile)
    else
        fallbackFile ..= block
    end
end

