local function recordRemote(remote, method, arguments, caller)
    if stopped then
        return
    end

    local label = watchedRemotes[remote] or remote.Name
    local character, root, humanoid = getCharacter()

    writeLine(
        "REMOTE_CALL",
        "label=" .. label,
        "path=" .. safeFullName(remote),
        "method=" .. method,
        "caller=" .. valueString(caller),
        "args=" .. describeArguments(arguments),
        "character=" .. valueString(character),
        "rootCFrame=" .. valueString(root and root.CFrame or nil),
        "humanoidState=" .. valueString(humanoid and humanoid:GetState() or nil),
        "floorMaterial=" .. valueString(humanoid and humanoid.FloorMaterial or nil)
    )

    if (label == "Sentry" or label == "MasteredSentry")
        and typeof(arguments[1]) == "CFrame" then

        local evaluation = evaluatePlacementCFrame(arguments[1])
        writeLine("PLACEMENT_REQUEST_EVALUATION", evaluation)

        lastSentryCall = {
            time = elapsed(),
            remote = remote,
            cframe = arguments[1],
            arguments = arguments,
            acceptedModel = nil
        }

        task.delay(5, function()
            if lastSentryCall
                and lastSentryCall.remote == remote
                and lastSentryCall.cframe == arguments[1]
                and not lastSentryCall.acceptedModel then

                writeLine(
                    "SERVER_DECISION_REJECTED_OR_NO_MODEL",
                    "remote=" .. safeFullName(remote),
                    "requested=" .. valueString(arguments[1]),
                    "note=no server-tagged sentry appeared within 5 seconds"
                )
            end
        end)
    end

    flush()
end

if type(hookmetamethod) == "function"
    and type(getnamecallmethod) == "function"
    and type(newcclosure) == "function" then

    local success, original = pcall(function()
        local old
        old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()

            if method == "FireServer" and watchedRemotes[self] then
                local arguments = table.pack(...)
                local caller

                if type(getcallingscript) == "function" then
                    local callerSuccess, callerResult = pcall(getcallingscript)
                    if callerSuccess then
                        caller = callerResult
                    end
                end

                task.defer(recordRemote, self, method, arguments, caller)
            end

            return old(self, ...)
        end))
        return old
    end)

    if success and type(original) == "function" then
        oldNamecall = original
        hookInstalled = true
        writeLine("REMOTE_HOOK", "installed=true", "mode=pass-through exact remotes only")
    else
        writeLine("REMOTE_HOOK", "installed=false", "error=" .. tostring(original))
    end
else
    writeLine("REMOTE_HOOK", "installed=false", "reason=capability missing")
end

