local function getCharacter()
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    return character, root, humanoid
end

local function findEngineerTool()
    local character = LocalPlayer.Character

    return (character and character:FindFirstChild("Engineer"))
        or LocalPlayer.Backpack:FindFirstChild("Engineer")
end

local function findEngineerScript()
    local tool = findEngineerTool()

    if not tool then
        return nil
    end

    for _, object in ipairs(tool:GetDescendants()) do
        if object:IsA("LocalScript") then
            return object
        end
    end

    return nil
end

local function attributesString(object)
    local attributes = object:GetAttributes()
    local entries = {}

    for key, value in pairs(attributes) do
        table.insert(entries, tostring(key) .. "=" .. valueString(value))
    end

    table.sort(entries)
    return "{" .. table.concat(entries, ",") .. "}"
end

local function tagsString(object)
    local success, tags = pcall(CollectionService.GetTags, CollectionService, object)

    if not success then
        return "{}"
    end

    table.sort(tags)
    return "{" .. table.concat(tags, ",") .. "}"
end

local function instanceProperties(object)
    local fields = {}

    local function add(key, value)
        table.insert(fields, key .. "=" .. valueString(value))
    end

    if object:IsA("BasePart") then
        add("CFrame", object.CFrame)
        add("Size", object.Size)
        add("Anchored", object.Anchored)
        add("CanCollide", object.CanCollide)
        add("CanTouch", object.CanTouch)
        add("CanQuery", object.CanQuery)
        add("Transparency", object.Transparency)
        add("Material", object.Material)
        add("CollisionGroup", object.CollisionGroup)
        add("Massless", object.Massless)
        add("AssemblyRootPart", object.AssemblyRootPart)
        add("AssemblyMass", object.AssemblyMass)
        add("AssemblyLinearVelocity", object.AssemblyLinearVelocity)
        add("AssemblyAngularVelocity", object.AssemblyAngularVelocity)
        add("ReceiveAge", safeProperty(object, "ReceiveAge"))
        add("NetworkOwnershipRule", safeProperty(object, "NetworkOwnershipRule"))

        local ownerFunction = rawget(ENV, "isnetworkowner") or _G.isnetworkowner
        if type(ownerFunction) == "function" then
            local success, owned = pcall(ownerFunction, object)
            add("IsNetworkOwner", success and owned or "error")
        end
    elseif object:IsA("Model") then
        local success, pivot = pcall(object.GetPivot, object)
        add("Pivot", success and pivot or "unavailable")
        add("PrimaryPart", object.PrimaryPart)
        add("Scale", safeProperty(object, "Scale"))
    elseif object:IsA("ValueBase") then
        add("Value", object.Value)
    elseif object:IsA("Attachment") then
        add("CFrame", object.CFrame)
        add("WorldCFrame", object.WorldCFrame)
    elseif object:IsA("Constraint") then
        add("Enabled", object.Enabled)
        add("Attachment0", safeProperty(object, "Attachment0"))
        add("Attachment1", safeProperty(object, "Attachment1"))
    elseif object:IsA("WeldConstraint") then
        add("Enabled", object.Enabled)
        add("Part0", object.Part0)
        add("Part1", object.Part1)
    elseif object:IsA("BodyMover") then
        add("Velocity", safeProperty(object, "Velocity"))
        add("AngularVelocity", safeProperty(object, "AngularVelocity"))
        add("MaxForce", safeProperty(object, "MaxForce"))
        add("MaxTorque", safeProperty(object, "MaxTorque"))
        add("P", safeProperty(object, "P"))
    elseif object:IsA("Sound") then
        add("SoundId", object.SoundId)
        add("Playing", object.Playing)
        add("Looped", object.Looped)
        add("Volume", object.Volume)
        add("PlaybackSpeed", object.PlaybackSpeed)
    elseif object:IsA("ParticleEmitter") then
        add("Enabled", object.Enabled)
        add("Rate", object.Rate)
        add("Lifetime", object.Lifetime)
        add("Texture", object.Texture)
    elseif object:IsA("Tool") then
        add("Enabled", object.Enabled)
        add("RequiresHandle", object.RequiresHandle)
        add("CanBeDropped", object.CanBeDropped)
        add("Grip", object.Grip)
    elseif object:IsA("GuiObject") then
        add("Visible", object.Visible)
        add("Active", object.Active)
        add("Position", object.Position)
        add("Size", object.Size)
    elseif object:IsA("RemoteEvent") or object:IsA("RemoteFunction") then
        add("ClassName", object.ClassName)
    elseif object:IsA("LuaSourceContainer") then
        add("Enabled", safeProperty(object, "Enabled"))
        add("RunContext", safeProperty(object, "RunContext"))
    end

    return "{" .. table.concat(fields, ",") .. "}"
end

local function dumpTree(root, label)
    if not root then
        writeLine("TREE_MISSING", label)
        return
    end

    writeLine("BEGIN_TREE", label, root)

    local objects = {root}
    for _, descendant in ipairs(root:GetDescendants()) do
        table.insert(objects, descendant)
    end

    for _, object in ipairs(objects) do
        writeLine(
            "OBJ",
            "path=" .. safeFullName(object),
            "class=" .. object.ClassName,
            "name=" .. object.Name,
            "attributes=" .. attributesString(object),
            "tags=" .. tagsString(object),
            "properties=" .. instanceProperties(object)
        )
        task.wait()
    end

    writeLine("END_TREE", label, "objects=" .. #objects)
end

local function getAllowedGrass()
    local result = {}
    local arena = Workspace:FindFirstChild("Arena")

    if not arena then
        return result
    end

    for _, islandName in ipairs({
        "main island",
        "island1",
        "island2",
        "island3",
        "island4"
    }) do
        local island = arena:FindFirstChild(islandName)
        local grass = island and island:FindFirstChild("Grass")

        if grass and grass:IsA("BasePart") then
            table.insert(result, grass)
        end
    end

    local defaultIsland = arena:FindFirstChild("default island")

    if defaultIsland then
        for _, object in ipairs(defaultIsland:GetChildren()) do
            if object:IsA("BasePart") and object.Material == Enum.Material.Grass then
                table.insert(result, object)
            end
        end
    end

    return result
end

local function evaluatePlacementCFrame(targetCFrame)
    local character, root, humanoid = getCharacter()
    local allowedGrass = getAllowedGrass()
    local grassParams = RaycastParams.new()
    grassParams.FilterType = Enum.RaycastFilterType.Include
    grassParams.FilterDescendantsInstances = allowedGrass
    grassParams.IgnoreWater = true

    local grassHit = Workspace:Raycast(
        targetCFrame.Position + Vector3.new(0, 10, 0),
        Vector3.new(0, -50, 0),
        grassParams
    )

    local worldParams = RaycastParams.new()
    worldParams.FilterType = Enum.RaycastFilterType.Exclude
    worldParams.FilterDescendantsInstances = character and {character} or {}
    worldParams.IgnoreWater = true

    local worldHit = Workspace:Raycast(
        targetCFrame.Position + Vector3.new(0, 10, 0),
        Vector3.new(0, -50, 0),
        worldParams
    )

    return {
        target = targetCFrame,
        playerRoot = root and root.CFrame or nil,
        playerDistance = root and (root.Position - targetCFrame.Position).Magnitude or nil,
        humanoidState = humanoid and humanoid:GetState() or nil,
        floorMaterial = humanoid and humanoid.FloorMaterial or nil,
        grassHit = grassHit and grassHit.Instance or nil,
        grassPosition = grassHit and grassHit.Position or nil,
        grassGap = grassHit and (targetCFrame.Position.Y - grassHit.Position.Y) or nil,
        worldHit = worldHit and worldHit.Instance or nil,
        worldPosition = worldHit and worldHit.Position or nil,
        worldGap = worldHit and (targetCFrame.Position.Y - worldHit.Position.Y) or nil,
        worldNormal = worldHit and worldHit.Normal or nil,
        allowedGrassCount = #allowedGrass,
        lastPreview = lastPreview,
        lastPreviewState = lastPreviewState
    }
end

local function evaluatePreview(model)
    if not model or not model.Parent then
        return nil
    end

    local hitbox = model:FindFirstChild("Hitbox", true)
    if not hitbox or not hitbox:IsA("BasePart") then
        return nil
    end

    local overlapParams = OverlapParams.new()
    overlapParams.FilterDescendantsInstances = {model}
    local obstacles = {}

    local success, touching = pcall(
        Workspace.GetPartsInPart,
        Workspace,
        hitbox,
        overlapParams
    )

    if success then
        for _, part in ipairs(touching) do
            if part.Transparency ~= 1 and part.CanQuery and part.Name ~= "Grass" then
                table.insert(obstacles, part)
            end
        end
    end

    local grassParams = RaycastParams.new()
    grassParams.FilterType = Enum.RaycastFilterType.Include
    grassParams.FilterDescendantsInstances = getAllowedGrass()
    local pivot = model:GetPivot()
    local grassHit = Workspace:Raycast(
        pivot.Position + Vector3.new(0, 10, 0),
        Vector3.new(0, -50, 0),
        grassParams
    )

    local obstaclePaths = {}
    for _, obstacle in ipairs(obstacles) do
        table.insert(obstaclePaths, safeFullName(obstacle))
    end

    return {
        valid = #obstacles == 0 and grassHit ~= nil,
        pivot = pivot,
        hitboxCFrame = hitbox.CFrame,
        hitboxSize = hitbox.Size,
        obstacles = obstaclePaths,
        grassHit = grassHit and grassHit.Instance or nil,
        grassPosition = grassHit and grassHit.Position or nil,
        indicatorColor = hitbox.Color,
        indicatorTransparency = hitbox.Transparency
    }
end

local knownModelNames = {
    Turret = true,
    TurretFirstLevel = true,
    Spinner = true,
    SpinnerFirstLevel = true,
    Booster = true,
    BoosterFirstLevel = true,
    Grabber = true,
    GrabberFirstLevel = true,
    Stomper = true,
