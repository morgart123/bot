}

local function isEngineerModel(model)
    if not model or not model:IsA("Model") then
        return false
    end

    return knownModelNames[model.Name]
        or model:GetAttribute("IsSentry") == true
        or model:GetAttribute("OwnerId") ~= nil
        or CollectionService:HasTag(model, "Sentry")
        or model:FindFirstChild("TurretStandBase", true) ~= nil
end

local function classifyModel(model)
    local ownerId = model:GetAttribute("OwnerId")
    local serverMarkers = ownerId ~= nil
        or model:GetAttribute("IsSentry") == true
        or CollectionService:HasTag(model, "Sentry")

    if serverMarkers then
        return "SERVER_SENTRY"
    end

    return "LOCAL_PREVIEW"
end

local function watchValueObject(object, model)
    if not object:IsA("ValueBase") then
        return
    end

    addConnection(object.Changed:Connect(function(value)
        writeLine(
            "SENTRY_VALUE_CHANGED",
            "model=" .. safeFullName(model),
            "path=" .. safeFullName(object),
            "value=" .. valueString(value)
        )
    end))
end

local function watchSound(object, model)
    if not object:IsA("Sound") then
        return
    end

    addConnection(object.Played:Connect(function()
        writeLine(
            "SENTRY_SOUND_PLAYED",
            "model=" .. safeFullName(model),
            "sound=" .. safeFullName(object),
            "soundId=" .. object.SoundId
        )
    end))

    addConnection(object.Ended:Connect(function()
        writeLine(
            "SENTRY_SOUND_ENDED",
            "model=" .. safeFullName(model),
            "sound=" .. safeFullName(object)
        )
    end))
end

local function watchTouchPart(object, model)
    if not object:IsA("BasePart") then
        return
    end

    if object.Name ~= "Hitbox" and object.Name ~= "Glove" then
        return
    end

    addConnection(object.Touched:Connect(function(otherPart)
        writeLine(
            "SENTRY_TOUCHED",
            "model=" .. safeFullName(model),
            "sensor=" .. safeFullName(object),
            "other=" .. safeFullName(otherPart)
        )
    end))
end

local function correlateServerModel(model)
    if not lastSentryCall then
        return
    end

    if lastSentryCall.acceptedModel then
        return
    end

    if elapsed() - lastSentryCall.time > 5 then
        return
    end

    lastSentryCall.acceptedModel = model
    local actualPivot = model:GetPivot()
    local requested = lastSentryCall.cframe

    writeLine(
        "SERVER_DECISION_ACCEPTED",
        "remote=" .. safeFullName(lastSentryCall.remote),
        "requested=" .. valueString(requested),
        "actual=" .. valueString(actualPivot),
        "positionError=" .. tostring((actualPivot.Position - requested.Position).Magnitude),
        "model=" .. safeFullName(model)
    )
end

local function watchEngineerModel(model)
    if watchedModels[model] then
        return
    end

    watchedModels[model] = true
    task.wait(0.05)

    if not model.Parent or not isEngineerModel(model) then
        watchedModels[model] = nil
        return
    end

    local kind = classifyModel(model)
    writeLine(
        "ENGINEER_MODEL_ADDED",
        "kind=" .. kind,
        "path=" .. safeFullName(model),
        "pivot=" .. valueString(model:GetPivot()),
        "attributes=" .. attributesString(model),
        "tags=" .. tagsString(model)
    )

    if kind == "LOCAL_PREVIEW" then
        lastPreview = model
    else
        correlateServerModel(model)
    end

    for _, object in ipairs(model:GetDescendants()) do
        watchValueObject(object, model)
        watchSound(object, model)
        watchTouchPart(object, model)
    end

    addConnection(model.DescendantAdded:Connect(function(object)
        writeLine(
            "SENTRY_DESCENDANT_ADDED",
            "model=" .. safeFullName(model),
            "path=" .. safeFullName(object),
            "class=" .. object.ClassName,
            "properties=" .. instanceProperties(object)
        )
        watchValueObject(object, model)
        watchSound(object, model)
        watchTouchPart(object, model)
    end))

    addConnection(model.DescendantRemoving:Connect(function(object)
        writeLine(
            "SENTRY_DESCENDANT_REMOVING",
            "model=" .. safeFullName(model),
            "path=" .. safeFullName(object),
            "class=" .. object.ClassName
        )
    end))

    addConnection(model.AttributeChanged:Connect(function(attribute)
        writeLine(
            "SENTRY_ATTRIBUTE_CHANGED",
            "model=" .. safeFullName(model),
            "attribute=" .. attribute,
            "value=" .. valueString(model:GetAttribute(attribute)),
            "attributes=" .. attributesString(model)
        )

        if classifyModel(model) == "SERVER_SENTRY" then
            correlateServerModel(model)
        end
    end))

    addConnection(model.AncestryChanged:Connect(function(_, parent)
        if parent == nil then
            writeLine(
                "ENGINEER_MODEL_REMOVED",
                "kind=" .. kind,
                "path=" .. model.Name
            )

            if lastPreview == model then
                lastPreview = nil
            end
        end
    end))

    task.spawn(function()
        local lastPivot
        local lastValidity
        local lastOwnership

        while not stopped and model.Parent do
            local pivot = model:GetPivot()
            local shouldLogPivot = not lastPivot
                or (pivot.Position - lastPivot.Position).Magnitude > 0.05
                or pivot.LookVector:Dot(lastPivot.LookVector) < 0.999

            if shouldLogPivot then
                writeLine(
                    "ENGINEER_MODEL_PIVOT",
                    "kind=" .. classifyModel(model),
                    "model=" .. safeFullName(model),
                    "pivot=" .. valueString(pivot)
                )
                lastPivot = pivot
            end

            if classifyModel(model) == "LOCAL_PREVIEW" then
                local state = evaluatePreview(model)

                if state then
                    lastPreviewState = state

                    if lastValidity ~= state.valid then
                        writeLine(
                            "PREVIEW_VALIDITY_CHANGED",
                            "valid=" .. tostring(state.valid),
                            "pivot=" .. valueString(state.pivot),
                            "hitboxCFrame=" .. valueString(state.hitboxCFrame),
                            "hitboxSize=" .. valueString(state.hitboxSize),
                            "obstacles=" .. valueString(state.obstacles),
                            "grassHit=" .. valueString(state.grassHit),
                            "grassPosition=" .. valueString(state.grassPosition),
                            "indicatorColor=" .. valueString(state.indicatorColor)
                        )
                        lastValidity = state.valid
                    end
                end
            else
                local base = model:FindFirstChild("TurretStandBase", true)

                if base and base:IsA("BasePart") then
                    local ownerFunction = rawget(ENV, "isnetworkowner") or _G.isnetworkowner
                    local owned = "unavailable"

                    if type(ownerFunction) == "function" then
                        local success, result = pcall(ownerFunction, base)
                        owned = success and result or "error"
                    end

                    if lastOwnership ~= owned then
                        writeLine(
                            "SENTRY_NETWORK_STATE",
                            "model=" .. safeFullName(model),
                            "base=" .. safeFullName(base),
                            "isNetworkOwner=" .. tostring(owned),
                            "anchored=" .. tostring(base.Anchored),
