local function describeArguments(arguments)
    local result = {}

    for index = 1, arguments.n or #arguments do
        table.insert(
            result,
            "Arg[" .. index .. "]=" .. valueString(arguments[index])
        )
    end

    return table.concat(result, " | ")
end

