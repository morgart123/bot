    end

    if hookInstalled and oldNamecall and type(hookmetamethod) == "function" then
        pcall(function()
            hookmetamethod(game, "__namecall", oldNamecall)
        end)
    end

    StatusLabel.Text = "STOPPED — saved: " .. FILE_NAME
end

