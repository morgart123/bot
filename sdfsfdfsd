local function numberFromBox(box, fallback)
    local normalized = string.gsub(box.Text, ",", ".")
    local number = tonumber(normalized)
    if not number or number ~= number or number == math.huge or number == -math.huge then
        box.Text = tostring(fallback)
        return fallback
    end
    return math.abs(number)
end

local function flatUnit(vector, fallback)
    local flat = Vector3.new(vector.X, 0, vector.Z)
    if flat.Magnitude < 0.001 then
        return fallback
    end
    return flat.Unit
end

local function updateIndicators(message)
    local sentry = state.sentry
    local root = state.root

    if not sentry or not root or not sentry.Parent or not root.Parent then
        indicators.Text = (message and (message .. "\n") or "")
            .. "SENTRY: NONE\nOWNED: - | TAGGED: - | ACTIVE: -\nTARGET ERROR: -"
        indicators.TextColor3 = Color3.fromRGB(235, 238, 244)
        return
    end

    local owner = ownsPhysics(root)
    local tagged = CollectionService:HasTag(sentry, "Sentry")
    local active = hasActiveTouch(sentry)
    local targetError = state.targetPosition
        and (state.targetPosition - root.Position).Magnitude
        or 0

    local firstLine = message or (state.controlling and "CONTROLLER: HOLDING" or "CONTROLLER: STOPPED")
    indicators.Text = string.format(
        "%s\nSENTRY: %s\nOWNED: %s | TAGGED: %s | ACTIVE: %s\nTARGET ERROR: %.2f",
        firstLine,
        sentry.Name,
        tostring(owner),
        tostring(tagged),
        tostring(active),
        targetError
    )

    indicators.TextColor3 = owner == false
        and Color3.fromRGB(255, 119, 119)
        or Color3.fromRGB(117, 255, 164)
end

local function captureNearest()
    stopController(true)

    local sentry, root, distance = findNearestOwnedSentry()
    if not sentry or not root then
        state.sentry = nil
        state.root = nil
        updateIndicators("PLACE A TURRET, THEN CAPTURE")
        log("CAPTURE REJECTED: OWNED SENTRY NOT FOUND")
        return false
    end

    local characterRoot = getCharacterRoot()
    state.sentry = sentry
    state.root = root
    state.originalPosition = root.Position
    state.targetPosition = root.Position
    state.originalPlayerYOffset = characterRoot
        and (root.Position.Y - characterRoot.Position.Y)
        or -3

    log("=== ENGINEER 3D DEMO CAPTURE ===")
    log("PLAYER:", LocalPlayer.Name, LocalPlayer.UserId)
    log("PRIVATE MARKER:", game.PrivateServerId ~= "" and "TRUE" or "UNKNOWN")
    log("SENTRY:", pathOf(sentry))
    log("ROOT:", pathOf(root))
    log("OWNER ID:", getOwnerId(sentry))
    log("DISTANCE:", string.format("%.3f", distance))
    log("NETWORK OWNER:", ownsPhysics(root))
    log("ORIGINAL POSITION:", state.originalPosition)
    log("PLAYER Y OFFSET:", state.originalPlayerYOffset)

    updateIndicators("CAPTURED — READY")
    return true
end

local function ensureReady()
    if not state.sentry
        or not state.root
        or not state.sentry.Parent
        or not state.root.Parent then
        updateIndicators("CAPTURE A LIVE SENTRY FIRST")
        return false
    end

    if getOwnerId(state.sentry) ~= LocalPlayer.UserId then
        updateIndicators("REJECTED: NOT YOUR SENTRY")
        return false
    end

    local owner = ownsPhysics(state.root)
    if owner == false then
        updateIndicators("REJECTED: NETWORK OWNER FALSE")
        log("MOVE REJECTED: NETWORK OWNER FALSE")
        return false
    end

    if not saveAndNeutralizeBodyVelocities() then
        updateIndicators("REJECTED: BODYVELOCITY NOT FOUND")
        return false
    end

    return true
end

local function setTarget(target, actionName)
    if not ensureReady() then
        return
    end

    state.targetPosition = target
    state.controlling = true
    state.returning = false
    state.returnStableSince = nil

    log("ACTION:", actionName)
    log("FROM:", state.root.Position)
    log("TARGET:", target)
    log("NETWORK OWNER:", ownsPhysics(state.root))
    updateIndicators(actionName)
end

local function moveByDirection(directionName)
    local characterRoot = getCharacterRoot()
    if not characterRoot then
        updateIndicators("CHARACTER ROOT NOT FOUND")
        return
    end

    local step = numberFromBox(stepBox, DEFAULT_STEP)
    local forward = flatUnit(characterRoot.CFrame.LookVector, Vector3.new(0, 0, -1))
    local right = flatUnit(characterRoot.CFrame.RightVector, Vector3.new(1, 0, 0))

    local directions = {
        UP = Vector3.new(0, 1, 0),
        DOWN = Vector3.new(0, -1, 0),
        LEFT = -right,
        RIGHT = right,
        FORWARD = forward,
        BACK = -forward,
    }

    local direction = directions[directionName]
    if not direction then
        return
    end

    local basePosition = state.targetPosition
        or (state.root and state.root.Position)

    if not basePosition then
        updateIndicators("CAPTURE A SENTRY FIRST")
        return
    end

    setTarget(basePosition + direction * step, directionName .. " " .. tostring(step))
end

local function moveBeside(side)
    local characterRoot = getCharacterRoot()
    if not characterRoot then
        updateIndicators("CHARACTER ROOT NOT FOUND")
        return
    end

    if not state.root or not state.originalPlayerYOffset then
        updateIndicators("CAPTURE A SENTRY FIRST")
        return
    end

    local distance = numberFromBox(sideBox, DEFAULT_SIDE_DISTANCE)
    local right = flatUnit(characterRoot.CFrame.RightVector, Vector3.new(1, 0, 0))
    local sign = side == "RIGHT" and 1 or -1

    local target = characterRoot.Position
        + right * distance * sign
        + Vector3.new(0, state.originalPlayerYOffset, 0)

    setTarget(target, "TP BESIDE " .. side .. " " .. tostring(distance))
end

local function beginRestore()
    if not state.root or not state.root.Parent or not state.originalPosition then
        updateIndicators("NOTHING TO RESTORE")
        return
    end

    if not ensureReady() then
        return
    end

    state.targetPosition = state.originalPosition
    state.controlling = true
    state.returning = true
    state.returnStableSince = nil
    log("ACTION: RESTORE TO", state.originalPosition)
    updateIndicators("RETURNING TO ORIGINAL")
end

