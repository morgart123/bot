local heartbeatConnection
heartbeatConnection = RunService.Heartbeat:Connect(function()
    if state.closed then
        return
    end

    if not state.controlling then
        return
    end

    local sentry = state.sentry
    local root = state.root
    local target = state.targetPosition

    if not sentry or not root or not target or not sentry.Parent or not root.Parent then
        log("CONTROLLER STOPPED: SENTRY DESTROYED")
        stopController(true)
        updateIndicators("SENTRY DESTROYED")
        return
    end

    if getOwnerId(sentry) ~= LocalPlayer.UserId then
        log("CONTROLLER STOPPED: OWNER ID CHANGED")
        stopController(true)
        updateIndicators("OWNER ID CHANGED")
        return
    end

    if networkOwnerFunction and ownsPhysics(root) == false then
        log("CONTROLLER STOPPED: NETWORK OWNERSHIP LOST")
        stopController(true)
        updateIndicators("NETWORK OWNERSHIP LOST")
        return
    end

    -- Re-apply the local neutralization in case the physics object updates.
    saveAndNeutralizeBodyVelocities()

    local errorVector = target - root.Position
    local distance = errorVector.Magnitude
    local desiredVelocity = Vector3.zero

    if distance > 0.025 then
        local speed = math.min(MAX_SPEED, math.max(0.8, distance * POSITION_GAIN))
        desiredVelocity = errorVector.Unit * speed
    end

    root.AssemblyLinearVelocity = desiredVelocity
    root.AssemblyAngularVelocity = Vector3.zero

    if state.returning then
        if distance <= 0.18 then
            state.returnStableSince = state.returnStableSince or os.clock()

            if os.clock() - state.returnStableSince >= 0.4 then
                log("RESTORE COMPLETE; ERROR:", string.format("%.3f", distance))
                stopController(true)
                updateIndicators("RESTORED — FORCES RESTORED")
            end
        else
            state.returnStableSince = nil
        end
    end
end)

